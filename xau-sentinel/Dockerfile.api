# Production-like image for the FastAPI backend. MT5 is not available in a
# Linux container (MetaTrader5 is Windows-only and skipped by its platform
# marker in requirements.txt), so this image always runs MODE=mock.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./requirements.txt
COPY api/requirements.txt ./api/requirements.txt
RUN pip install -r requirements.txt -r api/requirements.txt

COPY . .

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /app/data \
    && chown -R app:app /app/data
USER app

EXPOSE 8000

# A TCP probe, not an HTTP request: uvicorn only accepts connections once the
# lifespan startup (table init, knowledge seeding) has finished, and a socket
# connect writes no access-log line every interval. start-period covers a cold
# Docker Desktop boot.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1', 8000), 4).close()"

# config.py reads secrets from environment variables only. Each file-mounted
# Docker secret (/run/secrets/<name>) is exported as <NAME> just before uvicorn
# starts, so its value lives only inside the process, never in the container's
# configured environment (docker inspect).
ENTRYPOINT ["sh", "-c", "for f in /run/secrets/*; do [ -f \"$f\" ] || continue; n=$(basename \"$f\" | tr '[:lower:]' '[:upper:]'); v=$(cat \"$f\"); if [ -n \"$v\" ]; then export \"$n=$v\"; fi; done; exec \"$@\"", "--"]
# --timeout-keep-alive well above the Next.js proxy's pooled-connection idle
# time, so the proxy always closes an idle connection first. With uvicorn's
# 5 s default, a reused connection could be reset mid-request (seen once as a
# proxied ECONNRESET -> 500).
#
# DEP-002: `alembic upgrade head` runs once, every container start, before
# uvicorn -- it's the migration runner now (api/main.py's lifespan no
# longer creates/alters any table). A no-op when already at head.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn api.main:app --host 0.0.0.0 --port 8000 --timeout-keep-alive 75"]

// Generated from import statements. Not hand-edited.
// Red = part of a circular dependency. Dashed = lazy (in-function / dynamic) import.
// Dotted = type-only import. Bold edge = frontend -> backend over HTTP.
digraph components {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, compound=true, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9];
  edge  [color="#94a3b8", arrowsize=0.5];
  subgraph cluster_py { label="Python backend"; style="rounded"; color="#64748b"; fontsize=14;
    subgraph cluster_py__root_ { label="(root)"; style="rounded,dashed"; color="#94a3b8";
      "py:app" [label="app", fillcolor="#dbeafe", tooltip="app"];
      "py:config" [label="config", fillcolor="#dbeafe", tooltip="config"];
    }
    subgraph cluster_py_ai { label="ai"; style="rounded,dashed"; color="#94a3b8";

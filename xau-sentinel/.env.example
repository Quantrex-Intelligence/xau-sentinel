# --- Mode ---
# mock = run with synthetic data, no MT5 needed (default, safe for development)
# live = connect to a locally running MetaTrader 5 terminal (Windows only)
MODE=mock

# --- MT5 connection (only needed when MODE=live) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Broker symbol name for gold — brokers vary: XAUUSD, XAUUSD., XAUUSDm, GOLD, etc.
TRADING_SYMBOL=XAUUSD

# --- Session / display ---
# IANA timezone used for displaying session times in the UI. Internal storage stays UTC.
SESSION_TIMEZONE=UTC

# --- API ---
# Serve FastAPI's /docs, /redoc and /openapi.json. Default true (local dev and
# the E2E readiness checks use /docs). Production should set this to false:
# the docs publish the full endpoint map, write routes included.
API_DOCS_ENABLED=true

# A single shared-secret token required on every API route + the WebSocket.
# Leave blank for no auth (the local dev default). Set it before exposing
# this app beyond 127.0.0.1 — the frontend also needs the matching
# NEXT_PUBLIC_API_AUTH_TOKEN (frontend/.env.local) to keep working.
API_AUTH_TOKEN=

# --- Database ---
# DEP-002: PostgreSQL only (no SQLite fallback). Required — the app fails to
# start without it. docker-compose's own `postgres` service is reachable at
# postgresql+psycopg://xau:<POSTGRES_PASSWORD>@postgres:5432/xau_sentinel
# when running via `docker compose up`; for local (non-container) dev, point
# this at wherever you're running Postgres.
DATABASE_URL=
POSTGRES_PASSWORD=

# --- Analysis thresholds (all optional, sensible defaults are used if omitted) ---
SWING_LOOKBACK=3
DISPLACEMENT_ATR_MULT=1.5
LIQUIDITY_SWEEP_BUFFER_PIPS=0.5
EQUAL_LEVEL_TOLERANCE=0.5
ATR_PERIOD=14
HIGH_VOL_ATR_MULT=1.3
LOW_VOL_ATR_MULT=0.7
RETRACEMENT_MIN_PCT=0.2
RETRACEMENT_MAX_PCT=0.79

# Session windows in UTC hours (approximate, adjust for DST/broker offset as needed)
ASIAN_SESSION_START_UTC=0
ASIAN_SESSION_END_UTC=6
LONDON_SESSION_START_UTC=7
LONDON_SESSION_END_UTC=12
NY_SESSION_START_UTC=12
NY_SESSION_END_UTC=20

# --- Risk display (informational only, never used to place trades) ---
ACCOUNT_BALANCE=50000
RISK_PER_TRADE_PCT=0.3

# Seconds since the last tick before the UI shows a DATA STALE warning
DATA_STALE_SECONDS=120

# --- FundedNext risk monitor (read-only; see risk/rules.py for sourcing) ---
FUNDEDNEXT_SERVER_TIMEZONE=Europe/Nicosia
FUNDEDNEXT_WARNING_THRESHOLD_PCT=0.5
FUNDEDNEXT_CRITICAL_THRESHOLD_PCT=0.8
FUNDEDNEXT_BALANCE_MISMATCH_TOLERANCE_PCT=0.5

# --- AI Assistant (Stage 3) — read-only analyst/explainer over the engine's
# own output. It never places, modifies, or recommends executing a trade.
# provider: "anthropic" or "groq" (real answers, needs AI_API_KEY set to that
# vendor's key) or "mock" (offline, deterministic, no key required — good
# for local dev/CI). AI_MODEL must be a model name that vendor actually
# hosts — e.g. "llama-3.3-70b-versatile" for AI_PROVIDER=groq; the default
# below is an Anthropic model name only. Under docker-compose, this key is
# passed as a file-mounted secret (same as the Telegram/API_AUTH_TOKEN
# secrets) so a real key never appears in `docker inspect`.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=1024

# --- A+ Strategy Evaluation (Stage 4) — explicit, user-specified rules.
# See ai/strategy/rules.py for what each value gates.
AI_STRATEGY_SWEEP_WINDOW_MINUTES=60
AI_STRATEGY_SL_BUFFER=0.30
AI_STRATEGY_MIN_RR=3.0
AI_STRATEGY_FUNDEDNEXT_MAX_DAILY_LOSS_USED_PCT=50.0

# --- Strategy & Trading Knowledge RAG (Stage 5) — local, dependency-free
# retrieval over the project's own documented rules. See ai/knowledge/.
AI_EMBEDDING_PROVIDER=local
AI_KNOWLEDGE_MIN_SIMILARITY=0.18
AI_KNOWLEDGE_TOP_K=3
AI_KNOWLEDGE_CHUNK_SIZE=800
AI_KNOWLEDGE_CHUNK_OVERLAP=100

# --- AI Tool Calling (Stage 6) — lets the assistant request live, exact
# data (market/risk/journal/knowledge) through read-only tools instead of
# only a static per-turn context snapshot. See ai/tools/.
AI_TOOL_MAX_ROUNDS=4

# --- Trading Memory (Stage 7) — user-confirmed preferences/lessons/patterns,
# retrieved the same way as Stage 5's knowledge base. See ai/memory/.
AI_MEMORY_MIN_SIMILARITY=0.18
AI_MEMORY_TOP_K=3

# --- Historical Setup Similarity (Stage 8) — an explicit, documented
# weighted-feature heuristic, NOT statistically tuned. See ai/similarity/.
AI_SIMILARITY_WEIGHT_H1_STRUCTURE=0.12
AI_SIMILARITY_WEIGHT_M5_STRUCTURE=0.08
AI_SIMILARITY_WEIGHT_M15_STRUCTURE=0.05
AI_SIMILARITY_WEIGHT_H4_STRUCTURE=0.05
AI_SIMILARITY_WEIGHT_LIQUIDITY=0.20
AI_SIMILARITY_WEIGHT_MSS=0.15
AI_SIMILARITY_WEIGHT_DISPLACEMENT=0.15
AI_SIMILARITY_WEIGHT_REGIME=0.10
AI_SIMILARITY_WEIGHT_SESSION=0.05
AI_SIMILARITY_WEIGHT_RR=0.05
AI_SIMILARITY_RR_TOLERANCE=3.0
AI_SIMILARITY_DEFAULT_TOP_K=5
AI_SIMILARITY_DEFAULT_MIN_SIMILARITY=0.5

# --- Market Intelligence Layer (Stage 9) — macro/gold-fundamentals/cross-
# asset/economic-events/news evidence, reachable only via explicit tools
# (never auto-injected into every turn). See ai/market_intelligence/.
# "mock" (default here) or "real" (Stage 11 — FRED/Yahoo Finance/RSS, see
# below). Leave unset to follow MODE automatically (mock when MODE=mock,
# real when MODE=live).
MARKET_INTEL_MACRO_PROVIDER=mock
MARKET_INTEL_CROSS_ASSET_PROVIDER=mock
MARKET_INTEL_EVENTS_PROVIDER=mock
MARKET_INTEL_NEWS_PROVIDER=mock
MARKET_INTEL_NEWS_MAX_AGE_HOURS=48
MARKET_INTEL_NEWS_DEFAULT_LIMIT=10
MARKET_INTEL_EVENTS_DAYS_AHEAD=7
MARKET_INTEL_EVENTS_DAYS_BACK=1

# --- Real Free Market Intelligence Providers (Stage 11) ---
# Free, self-service key from https://fred.stlouisfed.org/docs/api/api_key.html
# — used by the "real" macro/cross-asset/events providers. Optional: left
# blank, those providers degrade to data_available=false (never a crash,
# never fabricated data) and the app still boots normally. Yahoo Finance's
# public chart endpoint and the two RSS news feeds need no key at all.
# Under docker-compose, a real key here is passed as a file-mounted secret
# (same as AI_API_KEY/Telegram/API_AUTH_TOKEN) so it never appears in
# `docker inspect`.
MARKET_INTEL_FRED_API_KEY=
MARKET_INTEL_HTTP_TIMEOUT_SECONDS=8.0
MARKET_INTEL_CACHE_TTL_MACRO_SECONDS=3600
MARKET_INTEL_CACHE_TTL_EVENTS_SECONDS=600
MARKET_INTEL_CACHE_TTL_NEWS_SECONDS=600
MARKET_INTEL_CACHE_TTL_CROSS_ASSET_SECONDS=120
MARKET_INTEL_STALE_AFTER_SECONDS=7200

# --- Real-Time Monitoring & In-App Alert Engine (Stage 13) — watches the
# existing deterministic engines for state transitions and turns them into
# typed, deduplicated, acknowledgeable in-app alerts. See ai/monitoring/.
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=20
MONITORING_EVENT_WARNING_MINUTES=30
ALERT_RETENTION_DAYS=30

# --- Telegram Alert Delivery (Stage 14) — an outbound notification sink
# for Stage 13's monitoring alerts only; never a control channel (no bot
# commands are ever accepted). Disabled by default. See ai/notifications/.
# TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID are secrets — leave blank here, set
# them only in your local, gitignored .env. Get a bot token from
# @BotFather on Telegram; get your chat id by messaging your bot once and
# checking https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF_SECONDS=2
TELEGRAM_HTTP_TIMEOUT_SECONDS=8.0
NOTIFICATION_PROVIDER=telegram

# --- Trade Review & Behavioral Intelligence (Stage 16) — a recurring
# behavioral pattern is only reported across at least this many trades.
# See ai/trade_review/.
TRADE_REVIEW_MIN_PATTERN_SAMPLE=3

# --- Strategy Analytics (Stage 17) — a dimension breakdown row below this
# many closed trades is labeled INSUFFICIENT SAMPLE. See ai/strategy_analytics/.
STRATEGY_ANALYTICS_MIN_SAMPLE=5

# --- Periodic Trading Digest (Stage 18) — a scheduled weekly/monthly
# summary sent over the existing Telegram provider. See ai/digest/.
DIGEST_ENABLED=false
DIGEST_WEEKLY_ENABLED=false
DIGEST_MONTHLY_ENABLED=false
DIGEST_WEEKLY_DAY=MONDAY
DIGEST_WEEKLY_TIME=09:00
DIGEST_MONTHLY_DAY=1
DIGEST_MONTHLY_TIME=09:00
DIGEST_POLL_INTERVAL_SECONDS=300

# --- FundedNext MCP Integration — a second, independent, read-only account-
# data source (account/balance/status, trading history, risk/rule/compliance
# data, payout info) from FundedNext's own official MCP server. Optional:
# left blank, this feature is off and the app still boots normally. MT5
# stays the only source for prices/candles/spread/open positions. Generate a
# token from your FundedNext dashboard. Under docker-compose, a real token
# here is passed as a file-mounted secret (same as AI_API_KEY/Telegram/
# MARKET_INTEL_FRED_API_KEY) so it never appears in `docker inspect`. See
# risk/fundednext_mcp.py.
FUNDEDNEXT_MCP_URL=https://mcp.fundednext.com
FUNDEDNEXT_MCP_TOKEN=
FUNDEDNEXT_MCP_TIMEOUT_SECONDS=15.0
FUNDEDNEXT_MCP_CACHE_TTL_SECONDS=60
